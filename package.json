{
  "name": "blood-hunt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8734 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8734 --strictPort",
    "typecheck": "tsc --noEmit",
    "pacing": "esbuild scripts/pacing.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/pacing.mjs --log-level=warning && node node_modules/.cache/pacing.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "puppeteer-core": "^24.6.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
